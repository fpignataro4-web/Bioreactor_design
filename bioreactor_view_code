from pathlib import Path

import matplotlib.patches as patches
import matplotlib.pyplot as plt
import numpy as np
import pandas as pd


# ------------------------------------------------------------
# Utility helpers
# ------------------------------------------------------------
def read_bioreactor_data(excel_name: str = 'bioreactor_design.xlsx') -> pd.DataFrame:
    """Read and validate the parameter sheet from the Excel file."""
    excel_path = Path(__file__).resolve().parent / excel_name
    if not excel_path.exists():
        raise FileNotFoundError(f"Il file '{excel_name}' non è stato trovato nella cartella del progetto.")

    df = pd.read_excel(
        excel_path,
        sheet_name='Specifics',
        skiprows=1,
        names=['Parameter', 'Value', 'Unit'],
    )
    df_clean = df.dropna(subset=['Parameter', 'Value']).set_index('Parameter')
    return df_clean


def get_float_value(df: pd.DataFrame, key: str, *, strict: bool = True) -> float:
    if key not in df.index:
        raise KeyError(f"Parametro mancante: '{key}'")
    value = df.loc[key, 'Value']
    try:
        return float(value)
    except (TypeError, ValueError) as e:
        if strict:
            raise ValueError(f"Il valore di '{key}' non è numerico: {value!r}") from e
        return np.nan


# ------------------------------------------------------------
# Read input data
# ------------------------------------------------------------
try:
    df_clean = read_bioreactor_data()

    N_disks = int(get_float_value(df_clean, 'N_disks'))
    L = get_float_value(df_clean, 'L')
    D_v = get_float_value(df_clean, 'D_v')
    t_d = get_float_value(df_clean, 't_d')
    S1 = get_float_value(df_clean, 'S1')
    D_d = get_float_value(df_clean, 'D_d')
    D_s = get_float_value(df_clean, 'D_s')
    liq_level = get_float_value(df_clean, 'Liquid level')

    if N_disks < 1:
        raise ValueError('N_disks deve essere almeno 1.')
    if D_v <= 0 or L <= 0 or D_d <= 0 or D_s <= 0:
        raise ValueError('Tutti i diametri e le lunghezze devono essere > 0.')
    if liq_level < 0 or liq_level > D_v:
        raise ValueError('Il livello del liquido deve essere compreso tra 0 e il diametro del reattore.')

except FileNotFoundError as e:
    print(f"Errore: {e}")
    raise SystemExit(1)
except Exception as e:
    print(f"Errore nella lettura del file o nei dati: {e}")
    raise SystemExit(1)


# ------------------------------------------------------------
# Geometry
# ------------------------------------------------------------
R_v = D_v / 2
R_d = D_d / 2
liq_y = -R_v + liq_level

# Keep spacing non-negative for visual consistency
if N_disks > 1:
    S_calc = (L - 2 * S1 - N_disks * t_d) / (N_disks - 1)
    if S_calc < 0:
        print('Avviso: la spaziatura calcolata è negativa; verrà mostrata come 0 per il disegno.')
        S_calc = 0
else:
    S_calc = 0


# ------------------------------------------------------------
# Figure and axes
# ------------------------------------------------------------
fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 6))

# ==========================================
# VISTA FRONTALE (Sezione / Colonna Sinistra)
# ==========================================

# Parte inferiore (semicilindrica)
theta = np.linspace(np.pi, 2 * np.pi, 200)
x_semi = R_v * np.cos(theta)
y_semi = R_v * np.sin(theta)
ax1.plot(x_semi, y_semi, color='black', lw=2)

# Parte superiore (rettangolare)
ax1.plot([-R_v, -R_v], [0, R_v], color='black', lw=2)
ax1.plot([R_v, R_v], [0, R_v], color='black', lw=2)
ax1.plot([-R_v, R_v], [R_v, R_v], color='black', lw=2)

# Riempimento liquido dinamico
if liq_y <= 0:
    x_liq = np.sqrt(R_v**2 - liq_y**2)
    x_fill = np.linspace(-x_liq, x_liq, 200)
    y_fill = -np.sqrt(R_v**2 - x_fill**2)
    ax1.fill_between(x_fill, y_fill, liq_y, color='lightblue', alpha=0.6)
else:
    x_fill = np.linspace(-R_v, R_v, 200)
    y_fill = -np.sqrt(R_v**2 - x_fill**2)
    ax1.fill_between(x_fill, y_fill, 0, color='lightblue', alpha=0.6)
    ax1.fill_between([-R_v, R_v], 0, liq_y, color='lightblue', alpha=0.6)

# Disco e albero in sezione
circle_disk = patches.Circle((0, 0), R_d, fill=True, facecolor='orange', alpha=0.5, edgecolor='darkorange', lw=2)
ax1.add_patch(circle_disk)

circle_shaft = patches.Circle((0, 0), D_s / 2, fill=True, color='gray', edgecolor='black', lw=1)
ax1.add_patch(circle_shaft)

ax1.set_xlim(-R_v - 2, R_v + 2)
ax1.set_ylim(-R_v - 2, R_v + 2)
ax1.set_title('Vista Frontale')
ax1.set_xlabel('Larghezza (cm)')
ax1.set_ylabel('Altezza (cm)')
ax1.set_aspect('equal')
ax1.grid(False)

# ==========================================
# VISTA LATERALE (Lunghezza / Colonna Destra)
# ==========================================

# Contenitore bioreattore (metà cilindrica inferiore, metà rettangolare superiore)
ax2.add_patch(patches.Rectangle((0, -R_v), L, R_v * 2, fill=False, edgecolor='black', lw=2))
ax2.axhline(0, color='gray', linestyle='--', lw=0.7)

# Livello del liquido
ax2.add_patch(patches.Rectangle((0, -R_v), L, liq_level, fill=True, color='lightblue', alpha=0.6))

# Albero centrale
ax2.add_patch(patches.Rectangle((0, -D_s / 2), L, D_s, fill=True, color='gray'))

current_x = S1
for _ in range(N_disks):
    ax2.add_patch(
        patches.Rectangle(
            (current_x, -R_d),
            t_d,
            D_d,
            fill=True,
            facecolor='orange',
            alpha=0.8,
            edgecolor='darkorange',
            lw=2,
        )
    )
    current_x += t_d + S_calc

ax2.set_xlim(-2, L + 2)
ax2.set_ylim(-R_v - 2, R_v + 2)
ax2.set_title('Vista Laterale')
ax2.set_xlabel('Lunghezza (cm)')
ax2.set_ylabel('Altezza (cm)')
ax2.set_aspect('equal')
ax2.grid(False)

# Rendering finale
plt.tight_layout()
# Optional: save the figure for export
# plt.savefig('bioreactor_design.png', dpi=300, bbox_inches='tight')
plt.show()
